@model LookClosely_Original.ViewModels.LevelViewModel


@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid text-center px-0">
    <h2 class="my-3">@Model.Name</h2>
    <p>Трудност: <span class="badge bg-warning text-dark">@Model.Difficulty</span></p>

    <div class="game-container position-relative d-inline-block shadow-lg border rounded overflow-hidden bg-dark">
        <img src="@Model.ImagePath" id="game-canvas" alt="Game Level"
             style="cursor: crosshair; height: 85vh; width: auto; max-width: 95vw; object-fit: contain; display: block;">

    </div>

    <div class="mt-3 mb-4">
        <a asp-action="Index" class="btn btn-secondary">Назад към нивата</a>
        <button class="btn btn-success px-4 fw-bold" onclick="checkScore()">Запази резултат</button>
    </div>
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        document.getElementById('game-canvas').addEventListener('click', function(e) {
            const rect = e.target.getBoundingClientRect();

            const xPercent = ((e.clientX - rect.left) / rect.width) * 100;
            const yPercent = ((e.clientY - rect.top) / rect.height) * 100;

            console.log(`Клик в проценти -> X: ${xPercent.toFixed(2)}%, Y: ${yPercent.toFixed(2)}%`);

            showClickMarker(e.clientX - rect.left, e.clientY - rect.top);

            window.lastClickX = xPercent;
            window.lastClickY = yPercent;
        });

        function showClickMarker(x, y) {
            const oldMarker = document.getElementById('click-marker');
            if (oldMarker) oldMarker.remove();

            const marker = document.createElement('div');
            marker.id = 'click-marker';
            marker.style.position = 'absolute';
            marker.style.left = (x - 20) + 'px';
            marker.style.top = (y - 20) + 'px';
            marker.style.width = '40px';
            marker.style.height = '40px';
            marker.style.border = '4px solid red';
            marker.style.borderRadius = '50%';
            marker.style.boxShadow = '0 0 10px white';
            marker.style.pointerEvents = 'none';

            document.querySelector('.game-container').appendChild(marker);
        }

        async function checkScore() {
            if (!window.lastClickX) {
                alert("Моля, първо кликнете върху снимката!");
                return;
            }

            const levelId = @Model.Id;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const response = await fetch(`/Levels/CheckClick?levelId=${levelId}&x=${window.lastClickX}&y=${window.lastClickY}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const result = await response.json();

                if (result.success) {
                    const marker = document.getElementById('click-marker');
                    if (marker) marker.style.borderColor = 'lime';

                    alert(result.message);
                    window.location.href = '/Levels/Index';
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error("Грешка при проверката:", error);
                alert("Възникна техническа грешка. Провери конзолата.");
            }
        }
    </script>
}
